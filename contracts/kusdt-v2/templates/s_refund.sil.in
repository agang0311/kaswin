pragma silverscript ^0.1.0;
// Kaswin kUSDT v2 — S_REFUND (Leaf: self-continuation only, 1~2 ticket rounds).
// Action: CLAIM_REFUND (pull-based refund by record index).
contract KusdtShardRefund(byte[] initialState) {
    byte[] state = initialState;
    int constant FEE_INPUTS = 8;
    int constant FEE_OUTPUTS = 4;
{{COMMON}}
    entry spend(int recIdx, int ownTailBytes, byte[] kcc20Suffix) {
        require(tx.version == 1 && this.activeInputIndex == 0);
        require(tx.inputs.length >= 2 && tx.inputs.length <= 8);
        require(length(state) >= 80 && state.slice(0, 2) == byte[](0x1401));

        int rc = unsigned(state[42]);
        int mask = unsigned(state[43]);
        require((rc == 1 || rc == 2) && length(state) == 44 + 36 * rc);

        int price = U63(state, 34);
        require(price >= PRICE_MIN && price <= TOKEN_AMOUNT_LIMIT / 2);

        int q0 = U32(state, 44);
        int q1 = 0;
        require(q0 >= 1 && q0 <= 2);
        if (rc == 2) {
            int cum1 = U32(state, 80);
            require(cum1 > q0 && cum1 <= 2);
            q1 = cum1 - q0;
        }

        int newMask = 0;
        int qty = 0;
        if (rc == 1) {
            require(mask == 0 && recIdx == 0);
            newMask = 1;
            qty = q0;
        } else {
            require(mask == 0 || mask == 1 || mask == 2);
            if (recIdx == 0) {
                require(mask == 0 || mask == 2);
                newMask = mask + 1;
                qty = q0;
            } else if (recIdx == 1) {
                require(mask == 0 || mask == 1);
                newMask = mask + 2;
                qty = q1;
            } else {
                require(false);
            }
        }

        int remTicketsBefore = q0 + q1;
        if (mask == 1) { remTicketsBefore = q1; }
        else if (mask == 2) { remTicketsBefore = q0; }
        int oldVaultAmt = remTicketsBefore * price;
        int refundAmt = qty * price;
        int remAmt = oldVaultAmt - refundAmt;

        byte[32] selfCid = OpInputCovenantId(0);
        byte[32] zero = ZERO;
        require(selfCid != zero && selfCid != KUSDT_CID);
        require(OpCovInputCount(selfCid) == 1 && OpCovInputIdx(selfCid, 0) == 0);
        require(OpCovInputCount(KUSDT_CID) == 1 && OpCovInputIdx(KUSDT_CID, 0) == 1);
        for (ii, 2, tx.inputs.length, 6) {
            require(OpInputCovenantId(ii) == zero);
        }

        require(tx.inputs[0].value == SHARD_LEDGER_DEPOSIT);
        { checkKcc20Suffix(kcc20Suffix); }
        { checkKcc20Input(1, oldVaultAmt, selfCid, byte[](0x04), kcc20Suffix, SHARD_VAULT_DEPOSIT); }
        { checkFee(FEE_CAP); }

        int recOff = 44 + 36 * recIdx;
        byte[32] buyerPk = byte[32](state.slice(recOff + 4, recOff + 36));
        require(buyerPk != zero);

        if (remAmt > 0) {
            // Non-final refund (rc == 2, mask == 0): continue shard and vault.
            byte[] tail = byte[](0x00);
            { tail = selfTail(0, ownTailBytes); }
            byte[] nextState = state.slice(0, 43) + byte[](newMask as byte[1]) + state.slice(44, length(state));
            require(tx.outputs.length == 3 || tx.outputs.length == 4);
            require(OpAuthOutputCount(0) == 1 && OpAuthOutputIdx(0, 0) == 0);
            require(OpCovOutputCount(selfCid) == 1 && OpCovOutputIdx(selfCid, 0) == 0);
            require(tx.outputs[0].value == SHARD_LEDGER_DEPOSIT);
            require(tx.outputs[0].scriptPubKey == byte[](new ScriptPubKeyP2SHFromRedeemScript(scriptFor(nextState, tail))));
            require(OpCovOutputCount(KUSDT_CID) == 2);
            { checkKcc20Output(1, remAmt, selfCid, byte[](0x04), kcc20Suffix, SHARD_VAULT_DEPOSIT, true); }
            { checkKcc20Output(2, refundAmt, buyerPk, byte[](0x00), kcc20Suffix, 1, false); }
            if (tx.outputs.length == 4) {
                require(OpOutputCovenantId(3) == zero && tx.outputs[3].value > 0 && tx.outputs[3].value <= VALUE_LIMIT);
            }
        } else {
            // Final refund: destroy shard ledger and return full 4 KAS deposit to firstBuyerPk.
            require(ownTailBytes == 0);
            require(tx.outputs.length == 2 || tx.outputs.length == 3);
            require(OpAuthOutputCount(0) == 0 && OpCovOutputCount(selfCid) == 0);
            { ordinaryP2PK(0, SHARD_TOTAL_DEPOSIT, pubkey(state.slice(2, 34))); }
            require(OpCovOutputCount(KUSDT_CID) == 1);
            { checkKcc20Output(1, refundAmt, buyerPk, byte[](0x00), kcc20Suffix, 1, false); }
            if (tx.outputs.length == 3) {
                require(OpOutputCovenantId(2) == zero && tx.outputs[2].value > 0 && tx.outputs[2].value <= VALUE_LIMIT);
            }
        }
    }
}
