pragma silverscript ^0.1.0;
// SOURCE CANDIDATE. Leaf: no foreign-template dependencies.
contract KaswinRollingWin(byte[] initialLedger) {
    byte[] ledger = initialLedger;
    int constant HEADER = 93;
    int constant TARGET_INPUTS = 17;
    int constant FEE_INPUTS = 17;
    int constant FEE_OUTPUTS = 3;
{{COMMON}}
    entry spend(int action, int ownTailBytes, byte[] targetSizes) {
        int cnt = U16(ledger, 57);
        int dir = HEADER + 36 * cnt;
        int lc = (length(ledger) - dir) / 36;
        int base = 0;
        if (cnt > 0) { base = U32(ledger, dir - 4); }
        int ltk = 0;
        if (lc > 0) { ltk = U32(ledger, dir + (lc - 1) * 36); }
        int pr = U63(ledger, 33);
        int cap = U32(ledger, 41);
        int minT = U32(ledger, 45);
        { checkManager(cnt, dir, lc, cap, minT, pr, base, ltk); }
        byte[] tail = byte[](0x00);
        { tail = selfTail(ownTailBytes); }
        int p = U16(ledger, 91);
        bool merge = cnt > 0 && ltk * pr < TAIL_POOL_MIN;
        require(base + ltk >= minT);
        // A merge-tail round terminates in its last PAY_OLD, never persisting p=N.
        require(p <= cnt - (merge ? 1 : 0));
        require(tx.inputs[0].value == DEPOSIT + ltk * pr);
        if (action == 20) {
            int k = tx.inputs.length - 1;
            require(k >= 1 && k <= 16 && length(targetSizes) == 4 * k);
            { checkTargets(k); }
            require(p + k <= cnt);
            int gross = 0;
            for (j, 0, k, 16) {
                byte[] b = byte[](0x00);
                b = frozenLedger(j + 1, p + j, U32(targetSizes, 4 * j), cnt);
                require(tx.inputs[j + 1].value == U32(b, 9181) * pr);
                gross = gross + tx.inputs[j + 1].value;
            }
            bool finalBatch = merge && p + k == cnt;
            if (finalBatch) { gross = gross + ltk * pr; }
            int paidFee = 0;
            { paidFee = fee(100000000); }
            int prize = gross - k * REWARD - paidFee;
            require(prize >= PRICE_MIN && tx.outputs.length == 3);
            if (finalBatch) {
                { stateCount(0); }
                { ordinary(0, prize, pubkey(ledger.slice(59, 91))); }
                { ordinary(1, DEPOSIT, pubkey(ledger.slice(1, 33))); }
            } else {
                { stateCount(1); }
                { stateOutput(0, set2(ledger, 91, p + k), tail, tx.inputs[0].value); }
                { ordinary(1, prize, pubkey(ledger.slice(59, 91))); }
            }
            { chosenPayment(2, k * REWARD); }
        } else if (action == 21) {
            { checkTargets(0); }
            require(length(targetSizes) == 0 && p == cnt && ltk > 0 && !merge);
            int paidFee = 0;
            { paidFee = fee(100000000); }
            int prize = ltk * pr - REWARD - paidFee;
            require(prize >= PRICE_MIN && tx.outputs.length == 3);
            { stateCount(0); }
            { ordinary(0, prize, pubkey(ledger.slice(59, 91))); }
            { ordinary(1, DEPOSIT, pubkey(ledger.slice(1, 33))); }
            { chosenPayment(2, REWARD); }
        } else { require(false); } // Retired actions 22/23 are not accepted.
    }
}
