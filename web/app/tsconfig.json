{
  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "allowJs": true, "checkJs": false, "allowImportingTsExtensions": true, "noEmit": true,
    "verbatimModuleSyntax": true, "skipLibCheck": true
  },
  "include": ["*.ts", "../ui/*.ts"]
}
